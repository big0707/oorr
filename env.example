# 项目环境变量配置
# 复制此文件为 .env.local 并填入你的真实值
# ⚠️ 不要将真实值提交到 Git！

# ============================================
# Firebase 前端配置（必须以 VITE_ 开头）
# 从 Firebase Console > Project Settings > General > Your apps 获取
# ============================================
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# ============================================
# Firebase 后端配置（用于 Vercel Serverless Functions）
# 从 firebase-service-account.json 文件获取
# 运行: cat firebase-service-account.json | jq -c .
# ============================================
FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# 本地开发使用文件路径（可选）
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# ============================================
# Supabase 配置
# 从 Supabase Dashboard > Project Settings > API 获取
# ============================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# ============================================
# API 配置
# ============================================
VITE_API_BASE_URL=/api

# ============================================
# AI 服务配置（根据实际使用的 AI 服务配置）
# ============================================
AI_API_KEY=your-ai-api-key
AI_API_BASE_URL=https://api.example.com
