# 项目环境变量配置
# 复制此文件为 .env.local (Vercel) 或 .env (Docker) 并修改相应配置

# ============================================
# Vercel + Supabase 配置（推荐）
# ============================================

# Supabase 配置（前端）
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase 配置（服务端 - 用于 Vercel Functions）
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# API 配置（本地开发）
VITE_API_BASE_URL=http://localhost:3000/api

# ============================================
# Docker 配置（传统架构）
# ============================================

# 前端配置
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8000

# 后端配置
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# 数据库配置（如需要）
DATABASE_URL=postgresql://user:password@db:5432/chat2cartoon

# Redis配置（如需要）
REDIS_URL=redis://redis:6379/0

# ============================================
# 通用配置
# ============================================

# AI服务配置（根据实际使用的AI服务配置）
AI_API_KEY=your_api_key_here
AI_API_BASE_URL=https://api.example.com

# 其他配置
NODE_ENV=development
PYTHON_ENV=development
